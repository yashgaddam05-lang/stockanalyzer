{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:route(watchlist-items|market-regime|price-history|score-history|alert-events|stock-search|data-health|preferences|portfolios|assistant|watchlists|catalysts|positions|stock-add|watchlist|backtest|filings|alerts|stocks)",
      "destination": "/api/router?__route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/refresh.ts": {
      "maxDuration": 120
    },
    "api/cron.ts": {
      "maxDuration": 120
    },
    "api/router.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=market",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron?job=stocks",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/cron?job=filings",
      "schedule": "0 10 * * *"
    }
  ],
  "regions": [
    "pdx1"
  ]
}
