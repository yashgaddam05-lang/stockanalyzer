{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:route(watchlist-items|market-regime|smart-money|price-history|score-history|alert-events|stock-search|data-health|preferences|portfolio-import|portfolios|assistant|watchlists|catalysts|positions|stock-add|watchlist|backtest|filings|alerts|stocks|voice)",
      "destination": "/api/router?__route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/refresh.ts": {
      "maxDuration": 120
    },
    "api/cron.ts": {
      "maxDuration": 120
    },
    "api/router.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=market",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron?job=stocks",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/cron?job=filings",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron?job=smart-money",
      "schedule": "30 10 * * *"
    }
  ],
  "regions": [
    "pdx1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
