{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:route(alert-events|alerts|backtest|catalysts|data-health|filings|market-regime|portfolios|positions|price-history|score-history|stocks|watchlist-items|watchlist|watchlists)",
      "destination": "/api/router?__route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/refresh.ts": {
      "maxDuration": 120
    },
    "api/cron.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=market",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron?job=stocks",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/cron?job=filings",
      "schedule": "0 10 * * *"
    }
  ],
  "regions": [
    "pdx1"
  ]
}
