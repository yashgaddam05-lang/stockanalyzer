{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:route(agent-knowledge|watchlist-items|market-regime|smart-money|price-history|score-history|alert-events|stock-search|data-health|preferences|portfolio-import|portfolios|assistant|watchlists|catalysts|positions|stock-add|watchlist|backtest|paper|billing|brokerage|filings|status|admin|alerts|stocks|voice)",
      "destination": "/api/router?__route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/refresh.ts": {
      "maxDuration": 120
    },
    "api/cron.ts": {
      "maxDuration": 300
    },
    "api/router.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=vapi",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron?job=market",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron?job=stocks",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/cron?job=paper",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/cron?job=paper-weekly",
      "schedule": "0 14 * * 6"
    },
    {
      "path": "/api/cron?job=filings",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron?job=smart-money",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron?job=research&slot=premarket",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron?job=research&slot=open",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron?job=research&slot=close",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/cron?job=brokerage",
      "schedule": "45 21 * * *"
    }
  ],
  "regions": [
    "pdx1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-EKYfaNIQnnT11aoex2ApVoFxYS1UEHRLU1lKFiCB7ms=' https://www.googletagmanager.com https://c.daily.co https://*.daily.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https://*.daily.co; connect-src 'self' https://api.vapi.ai wss://api.vapi.ai https://*.daily.co wss://*.daily.co https://*.wss.daily.co wss://*.wss.daily.co https://irbwaucilrznbqynhtmr.supabase.co wss://irbwaucilrznbqynhtmr.supabase.co https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "staging.3xhunter.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "stockanalyzer-git-staging-bolot1.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
